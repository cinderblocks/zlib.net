<Project>
  <!-- Public source-distribution key: strong names establish assembly identity, not publisher trust.
       Keep this key stable across releases. All friend assemblies must use its full public key. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)zlib.snk</AssemblyOriginatorKeyFile>
    <ZlibPublicKey></ZlibPublicKey>
  </PropertyGroup>
</Project>
