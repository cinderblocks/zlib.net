<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <!-- Also exercise the netstandard2.0 asset on .NET Framework where it is available. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <!-- By default the best-matching asset is used (netstandard2.1 on modern .NET). Pass -p:LibraryTfm=netstandard2.0
       to run the same tests against the netstandard2.0 build, which is what .NET Framework consumers get. -->
  <ItemGroup Condition="'$(LibraryTfm)' == ''">
    <ProjectReference Include="..\..\zlib.net.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(LibraryTfm)' == 'netstandard2.0'">
    <DefineConstants>$(DefineConstants);LIB_NETSTANDARD20</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(LibraryTfm)' != ''">
    <ProjectReference Include="..\..\zlib.net.csproj" SetTargetFramework="TargetFramework=$(LibraryTfm)" />
  </ItemGroup>
</Project>
