<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 2.0 replaces the misspelled "zlib.net-mutliplatform" ID, which stays on nuget.org at 1.x. -->
    <PackageId>zlib.net-multiplatform</PackageId>
    <Product>zlib.net</Product>
    <Description>ZLIB.NET is a 100% managed version of ZLIB compression library which implements deflate and inflate compression algorithms.</Description>
    <Copyright>Copyright © 2006-2007, ComponentAce, 2022-2025 Sjofn LLC</Copyright>
    <AssemblyTitle>zlib.net</AssemblyTitle>
    <Version>2.0.0</Version>
    <Company>ComponentAce</Company>
    <Authors>cinderblocks</Authors>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <DebugType>portable</DebugType>
    <AssemblyName>zlib.net</AssemblyName>
    <PackageTags>zlib;deflate;compression</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/cinderblocks/zlib.net</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/cinderblocks/zlib.net.git</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Packages are produced explicitly with `dotnet pack` (see .github/workflows). -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Validates the package's target frameworks on `dotnet pack`. After the first release under this ID,
         add <PackageValidationBaselineVersion> to also catch public API regressions. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- Source Link (bundled with the .NET SDK) and reproducible builds. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- tests/ lives under this project's folder; keep it (and its bin/obj) out of the library. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;benchmarks/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="zlib.net.Tests" />
    <InternalsVisibleTo Include="zlib.net.Benchmarks" />
  </ItemGroup>
</Project>
