<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 2.0 replaces the misspelled "zlib.net-mutliplatform" ID, which stays on nuget.org at 1.x. -->
    <PackageId>ZlibCore</PackageId>
    <Product>zlib.net</Product>
    <Description>ZLIB.NET is a 100% managed version of ZLIB compression library which implements deflate and inflate compression algorithms.</Description>
    <Copyright>Copyright © 2006-2007, ComponentAce, 2022-2025 Sjofn LLC</Copyright>
    <AssemblyTitle>zlib.net</AssemblyTitle>
    <Version>2.0.1</Version>
    <Company>ComponentAce</Company>
    <Authors>cinderblocks</Authors>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <DebugType>portable</DebugType>
    <AssemblyName>zlib.net</AssemblyName>
    <PackageTags>zlib;deflate;compression</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/cinderblocks/zlib.net</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/cinderblocks/zlib.net.git</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;benchmarks/**;fuzz/**</DefaultItemExcludes>

    <!-- Nullable annotations need C# 8+, which the netstandard2.0 target can use with this setting. The internal
         engine files (a straight port of zlib) opt out with #nullable disable; the public surface is annotated. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- XML documentation ships with the package for IntelliSense. The zlib-style constants and fields are
         self-describing, so CS1591 (missing comment) is not enforced. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Pure managed code, so the modern target can promise trimming and Native AOT compatibility. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="zlib.net.Tests" />
    <InternalsVisibleTo Include="zlib.net.Benchmarks" />
  </ItemGroup>
</Project>
